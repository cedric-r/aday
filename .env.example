# A Day In The Life — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Application secret — used for HMAC validation tokens.
# Use a long random string (e.g. openssl rand -hex 32).
# If value contains special chars (; # = { }) it MUST be quoted:
#   APP_SECRET="p@ss;word-with-special-chars"
APP_SECRET=change-me-to-a-random-64-char-hex-string

# Environment: production | development
# Set to "development" to disable the Secure cookie flag (local HTTP dev only).
APP_ENV=production

# SQLite database file path (relative to project root).
# Ensure the data/ directory is writable by the web server process.
DB_PATH=data/aday.sqlite

# SMTP sender address — used in validation emails.
SMTP_FROM=noreply@example.com

# Admin email address — receives user validation email links.
ADMIN_EMAIL=admin@example.com

# Public site base URL — used to build absolute links in outgoing emails.
APP_URL=https://aday.photoni.st

# PHP upload limits — these cannot be set in PHP code; set in php.ini:
#   upload_max_filesize = 16M
#   post_max_size       = 17M
# The application enforces a 15 MB limit in code but php.ini must allow it.
