RewriteEngine On
Options -Indexes

# ---- Upload limits (mod_php per-dir override; php.ini defaults are 2M/8M) ----
php_value upload_max_filesize 16M
php_value post_max_size 17M

# ---- Wordfence WAF exclusion: override the parent photoni.st .htaccess
# prepend (wordfence-waf.php) with a local no-op for this app. The aday
# app is vanilla PHP with its own hardening; Wordfence's WordPress rules
# false-positive on real photo uploads (embedded PHP-like bytes in EXIF,
# HTML-ish captions). Revert = restore the line to the parent value. ----
php_value auto_prepend_file "/var/www/photoni.st/aday/.waf-off.php"

# ---- Security: never serve private files / dirs ----
RewriteRule ^(\.env|composer\.(json|lock)|phpstan\.neon|phpunit\.xml|package(-lock)?\.json|vite\.config\.ts|eslint\.config\.js|tsconfig.*\.json)$ - [F,L]
RewriteRule ^(data|logs|coverage|\.git|\.specifications|node_modules|src|tests|vendor|lib|config|migrations|scripts|docs|public)/ - [F,L]
RewriteRule ^api/data/ - [F,L]

# ---- API and PHP endpoints reach mod_php directly ----
RewriteCond %{REQUEST_URI} ^/api/ [OR]
RewriteCond %{REQUEST_URI} ^/setup\.php$
RewriteRule .* - [L]

# ---- Static asset aliases (Vite builds into dist/) ----
RewriteRule ^assets/(.*)$ /dist/assets/$1 [L]
RewriteRule ^documentyourlife\.png$ /dist/documentyourlife.png [L]

# ---- Frame protections (clickjacking) ----
# /embed is the sole embedding surface (Substack iframe). THE_REQUEST keeps
# the ORIGINAL request line across the SPA-fallback rewrite to
# dist/index.html, so per-path CSP works reliably here.
<If "%{THE_REQUEST} !~ m#/embed(\?| |$)#">
  Header always set Content-Security-Policy "frame-ancestors 'none'"
</If>
<If "%{THE_REQUEST} =~ m#/embed(\?| |$)#">
  Header always set Content-Security-Policy "frame-ancestors *"
</If>

# ---- Embed route: served through PHP (cache-busting shell; CSP handled by
# the <If> block above). Must come before the SPA fallback. ----
RewriteRule ^embed$ embed.php [L]

# ---- Per-photo pages: server-render social meta tags alongside the SPA ----
RewriteRule ^photos/([0-9]+)/?$ photo-meta.php?id=$1 [L,QSA]

# ---- Never serve Vite's source index.html or stray SQLite files ----
RewriteRule ^index\.html$ /dist/index.html [L]
RewriteRule ^.*\.sqlite(?:-wal|-shm)?$ - [F,L]

# ---- SPA entry point ----
DirectoryIndex /dist/index.html

# ---- SPA fallback: any other path -> dist/index.html ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /dist/index.html [L]