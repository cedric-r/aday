RewriteEngine On
Options -Indexes

# ---- Upload limits (mod_php per-dir override; php.ini defaults are 2M/8M) ----
php_value upload_max_filesize 16M
php_value post_max_size 17M

# ---- Security: never serve private files / dirs ----
RewriteRule ^(\.env|composer\.(json|lock)|phpstan\.neon|phpunit\.xml|package(-lock)?\.json|vite\.config\.ts|eslint\.config\.js|tsconfig.*\.json)$ - [F,L]
RewriteRule ^(data|logs|coverage|\.git|\.specifications|node_modules|src|tests|vendor|lib|config|migrations|scripts|docs|public)/ - [F,L]
RewriteRule ^api/data/ - [F,L]

# ---- API and PHP endpoints reach mod_php directly ----
RewriteCond %{REQUEST_URI} ^/api/ [OR]
RewriteCond %{REQUEST_URI} ^/setup\.php$
RewriteRule .* - [L]

# ---- Static asset aliases (Vite builds into dist/) ----
RewriteRule ^assets/(.*)$ /dist/assets/$1 [L]
RewriteRule ^documentyourlife\.png$ /dist/documentyourlife.png [L]

# ---- Frame protections (clickjacking): deny everywhere except /embed ----
# /embed is deliberately frameable (Substack etc.); everything else must not
# render inside someone else's page. Requires mod_headers (checked at deploy).
SetEnvIf Request_URI "^/embed(\?.*)?$" allow_embed_framing=1
Header always set X-Frame-Options "DENY" env=!allow_embed_framing
Header always set Content-Security-Policy "frame-ancestors 'none'" env=!allow_embed_framing
Header unset X-Frame-Options env=allow_embed_framing
Header always set Content-Security-Policy "frame-ancestors *" env=allow_embed_framing

# ---- Per-photo pages: server-render social meta tags alongside the SPA ----
RewriteRule ^photos/([0-9]+)/?$ photo-meta.php?id=$1 [L,QSA]

# ---- Never serve Vite's source index.html or stray SQLite files ----
RewriteRule ^index\.html$ /dist/index.html [L]
RewriteRule ^.*\.sqlite(?:-wal|-shm)?$ - [F,L]

# ---- SPA entry point ----
DirectoryIndex /dist/index.html

# ---- SPA fallback: any other path -> dist/index.html ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /dist/index.html [L]